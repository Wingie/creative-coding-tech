{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://creativecodingtech.com",
          "https://www.creativecodingtech.com",
          "http://localhost:4000",
          "http://127.0.0.1:4000",
          "http://localhost:4001",
          "http://127.0.0.1:4001"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
